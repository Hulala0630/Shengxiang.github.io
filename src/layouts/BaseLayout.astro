---
import "../styles/global.css";
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const alternateLocale = locale === "zh" ? "en" : "zh";
const alternateHref = locale === "zh" ? "/en/" : "/";
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e7" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang="zh" href={new URL("/", Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("bauhaus-theme") || "light";
      } catch {}
    </script>
  </head>
  <body data-locale={locale}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <a
      class="locale-fallback"
      href={alternateHref}
      hreflang={alternateLocale}
      hidden
    >
      {alternateLocale}
    </a>
  </body>
</html>
